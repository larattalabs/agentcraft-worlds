{
  "name": "agentcraft-foreman",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "AgentCraft Foreman: multi-agent orchestrator (Claude Agent SDK) that the Minecraft mod renders.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "tui": "node --import tsx scripts/fake-mod.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:protocol-doc": "node --import tsx scripts/gen-protocol-doc.ts",
    "gen:java-protocol": "node --import tsx scripts/gen-java-protocol.ts",
    "pr-probe": "node --import tsx scripts/pr-probe.ts",
    "check:protocol-doc": "node --import tsx scripts/gen-protocol-doc.ts --check",
    "check:java-protocol": "node --import tsx scripts/gen-java-protocol.ts --check",
    "check": "tsc --noEmit && vitest run && node --import tsx scripts/gen-protocol-doc.ts --check && node --import tsx scripts/gen-java-protocol.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
