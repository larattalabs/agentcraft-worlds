{
	"schemaVersion": 1,
	"id": "agentcraft_worlds",
	"version": "${version}",
	"name": "AgentCraft Worlds",
	"description": "Teams of Claude agents doing real work on your code, in Minecraft buildings you place in your own world. A fork of AgentCraft by blendi-remade.",
	"authors": [
		"Blendi",
		"Laratta Labs"
	],
	"license": "MIT",
	"icon": "assets/agentcraft_worlds/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.agentcraft.AgentCraft"
		],
		"client": [
			"dev.agentcraft.client.AgentCraftClient"
		]
	},
	"mixins": [
		"agentcraft_worlds.mixins.json",
		{
			"config": "agentcraft_worlds.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"contact": {
		"homepage": "https://github.com/larattalabs/agentcraft-worlds",
		"sources": "https://github.com/larattalabs/agentcraft-worlds",
		"issues": "https://github.com/larattalabs/agentcraft-worlds/issues"
	}
}
